/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include "carnlog-pinctrl.dtsi"

/ {
	model = "An LTE, BLE and USB-FS OBD II datalogger for modern commercial vehicles";
	compatible = "labfermion,carnlog";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	leds {
		compatible = "gpio-leds";

		led {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "status led";
		};
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0xc000 DT_SIZE_K(472)>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x82000 DT_SIZE_K(472)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0xf8000 DT_SIZE_K(32)>;
		};
	};
};

&gpio0 {
	status = "okay";
};

&i2c0 {

	status = "okay";
	pinctrl-0 = <&i2c0_i2c0_default>;
	pinctrl-names = "i2c0_default";
	label = "lsm6d i2c";
	clock-frequency = <DT_FREQ_K(400)>;

	lsmdso@0 {
		compatible = "st,lsm6ds0";
		reg = <0x0>;
		interrupts = <0 0>;
	};
};

&pinctrl {
	i2c0_i2c0_default: i2c0_i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 9)>, <NRF_PSEL(TWIM_SDA, 0, 10)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};
	};
};
